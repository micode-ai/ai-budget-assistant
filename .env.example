# Backend API
DATABASE_URL=postgresql://user:password@localhost:5432/budget_assistant
REDIS_URL=redis://localhost:6379
JWT_SECRET=your-jwt-secret-here
JWT_REFRESH_SECRET=your-jwt-refresh-secret-here
JWT_EXPIRES_IN=7d
# Google Sign-In — comma-separated OAuth client IDs accepted as ID-token audiences (web,ios,android)
GOOGLE_OAUTH_CLIENT_IDS=587710971480-l2noql6vqb8bikcfc0ef3juom9h51gbi.apps.googleusercontent.com,587710971480-2sc9b42b8f6tbq9ee9pat3ivc24nt7kd.apps.googleusercontent.com

# CORS — comma-separated list of allowed origins (e.g. https://app.ai-budget.pl,https://admin.ai-budget.pl)
# Leave unset for local dev (defaults to localhost:8081 and localhost:3001)
CORS_ORIGIN=

# Admin access
ADMIN_EMAILS=admin@example.com

# OpenAI
OPENAI_API_KEY=your-openai-api-key

# Firebase (for push notifications)
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-secret

# Telegram bot — USER-FACING ASSISTANT ONLY (expenses, chat, voice, photo).
# TELEGRAM_CHAT_ID is legacy/unused by the API now that ops moved to the ops bot below.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_URL=
# Secret token passed to Telegram setWebhook (required in production webhook mode)
TELEGRAM_WEBHOOK_SECRET=your-telegram-webhook-secret

# MiCode ops bot — SEPARATE from the assistant bot. All operational alerts
# (new registrations, payments, referrals, request-a-bank, and the uptime/backup/
# infra GitHub workflows) go here, NOT to the user-facing assistant bot. No
# fallback: if these are unset, ops notifications are simply not sent.
# OPS_TELEGRAM_BOT_TOKEN + OPS_TELEGRAM_CHAT_ID must ALSO be set as GitHub Actions
# secrets for uptime-check.yml / backup-db.yml / infra-watch.yml.
OPS_TELEGRAM_BOT_TOKEN=
OPS_TELEGRAM_CHAT_ID=
# Optional label prefixed to every ops message so a shared MiCode ops channel can
# tell projects apart (e.g. "AI Budget"). Omit for no prefix.
OPS_PROJECT_NAME=AI Budget

# WhatsApp Business Cloud API
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_BUSINESS_PHONE_NUMBER=
WHATSAPP_API_VERSION=v21.0

# Slack Bot (DM 1:1). Create an app at https://api.slack.com/apps.
# Bot token scopes: chat:write, im:history, im:read, im:write, files:read.
# Event subscriptions: message.im. Interactivity Request URL: /slack/interactivity.
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_APP_ID=
SLACK_BOT_USER=
# Slack OAuth (multi-workspace install). Required to let other workspaces add the bot.
# Redirect URL must be registered in the Slack app's OAuth & Permissions → Redirect URLs,
# and Public Distribution activated under Manage Distribution.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_OAUTH_REDIRECT_URL=https://api.ai-budget.pl/slack/oauth/callback
# 32-byte key (64 hex chars or base64) used to encrypt per-workspace bot tokens at rest.
SLACK_TOKEN_ENC_KEY=

# Community Price Map (ABA-335, M1 write pipeline). Salt used to derive the
# one-way `contributorKey` (sha256(salt + accountId)) stored on each anonymized
# community_price_observations row. Required for any contribution to be
# recorded — if unset, CommunityPriceService.recordContribution no-ops
# (fail-silent) rather than ever use a weak/absent key. Generate with
# `openssl rand -hex 32`. Rotating this salt is a privacy feature (breaks
# correlation with historical rows) but also resets the one-vote-per-week dedup
# for every account — do not rotate casually.
COMMUNITY_PRICE_SALT=
# k-anonymity threshold for the community price read API (ABA-335 M2): a
# (product, store, region, week) price point is exposed only when backed by at
# least this many DISTINCT contributing accounts. Optional; defaults to 5 (min 2).
COMMUNITY_PRICE_K=
# Read kill-switch (ABA-335 security audit). The k-anonymity gate does not by
# itself defend against a Sybil attacker who controls the write path, so the
# community read API (GET /price-history/community[/products]) returns EMPTY
# until this is explicitly "true". Keep unset/false until the anti-Sybil design
# work lands; the write pipeline keeps filling the corpus in the meantime.
COMMUNITY_PRICE_READ_ENABLED=
# Anti-Sybil contributor eligibility (ABA-335): an account must be at least this
# many days old AND have at least this many real tracked expenses before its
# receipts feed the shared corpus. Optional; default 7 days / 15 expenses. Raise
# both to harden further (at the cost of a slower-filling corpus).
COMMUNITY_MIN_ACCOUNT_AGE_DAYS=
COMMUNITY_MIN_CONTRIBUTOR_EXPENSES=
# Anti-Sybil multi-week persistence (ABA-335): a store is only exposed if it has
# data in at least COMMUNITY_MIN_PERSISTENCE_WEEKS distinct weeks over the last
# COMMUNITY_PERSISTENCE_LOOKBACK_WEEKS — blocks a single-week burst of throwaway
# accounts. The displayed price still comes from the requested 1w/4w period.
# Optional; default 2 distinct weeks over an 8-week lookback.
COMMUNITY_MIN_PERSISTENCE_WEEKS=
COMMUNITY_PERSISTENCE_LOOKBACK_WEEKS=

# Mobile app
EXPO_PUBLIC_API_URL=http://localhost:3000/api
# Google Sign-In OAuth client IDs (per platform)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=587710971480-l2noql6vqb8bikcfc0ef3juom9h51gbi.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=587710971480-2sc9b42b8f6tbq9ee9pat3ivc24nt7kd.apps.googleusercontent.com

# --- Database backup (Phase 1, GitHub Actions: .github/workflows/backup-db.yml) ---
# These are configured as GitHub repository secrets, not in this .env. Listed here for reference.
# AGE_PUBLIC_KEY      - age recipient public key (age1...); the runner encrypts dumps with it.
#                       The matching PRIVATE key is kept OFFLINE by the owner (+ a second copy)
#                       and is the only thing that can decrypt backups.
# BACKUP_REPO         - owner/repo of the private repo that stores backup Releases (e.g. owner/ai-budget-backups)
# BACKUP_REPO_TOKEN   - fine-grained PAT with `contents: write` on BACKUP_REPO
# Reused existing secrets: SSH_HOST, SSH_USER, SSH_PRIVATE_KEY, TELEGRAM_BOT_TOKEN, TELEGRAM_CHAT_ID
