model ChatConversation {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  accountId String?  @map("account_id")
  isShared  Boolean  @default(false) @map("is_shared")
  title     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  user     User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  account  Account?              @relation(fields: [accountId], references: [id], onDelete: Cascade)
  messages ChatMessage[]
  pins     ChatConversationPin[]

  @@index([accountId, updatedAt])
  @@map("chat_conversations")
}

// Per-viewer pin, NOT a column on ChatConversation. `getConversations`' list is
// heterogeneous (it contains other members' shared conversations via
// `OR: [{ isShared: true }, { userId }]`), so a pin-as-column would be
// creator-only: the non-creator who reads a shared conversation daily could
// never pin it, and a creator pinning their own shared conversation would pin
// it for everyone. See docs/design/2026-09-07-chat-conversation-management.md
// "The pin fork — ruled: per viewer".
//
// No `accountId` here on purpose: pins are per-account BY CONSTRUCTION — the
// conversation carries the account and `getConversations` filters on it, so a
// pin can only ever surface in the account whose conversation it points at.
//
// The composite id is the uniqueness constraint and the dedup: pinning is
// `createMany({ data: [row], skipDuplicates: true })` and unpinning is
// `deleteMany({ where: { userId, conversationId } })` — both idempotent,
// neither inside a `$transaction` (a constraint violation would poison it,
// ABA-313/401).
model ChatConversationPin {
  userId         String   @map("user_id")
  conversationId String   @map("conversation_id")
  pinnedAt       DateTime @default(now()) @map("pinned_at")

  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@id([userId, conversationId])
  @@index([userId])
  @@map("chat_conversation_pins")
}

model ChatMessage {
  id               String   @id @default(uuid())
  conversationId   String   @map("conversation_id")
  role             String
  content          String
  // Soft reference (no FK): preserves shared-chat history if the author is deleted; name resolved at read time
  senderUserId     String?  @map("sender_user_id")
  mentionedUserIds String[] @map("mentioned_user_ids")
  tokensUsed       Int?     @map("tokens_used")
  createdAt        DateTime @default(now()) @map("created_at")

  // Relations
  conversation ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("chat_messages")
}

model SyncLog {
  id                 String   @id @default(uuid())
