generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---- Enums ----

enum AccountType {
  personal
  business
  shared
  investment
  trip
}

enum TripStatus {
  active
  settling
  archived
}

enum ShareType {
  equal
  exact
  percentage
  shares
}

enum SettleMethod {
  blik
  revolut
  paypal
  cash
  other
}

enum SettleStatus {
  pending
  confirmed
}

enum AccountRole {
  owner
  editor
  viewer
}

enum InvitationStatus {
  pending
  accepted
  declined
  expired
}

enum ReferralStatus {
  pending
  qualified
  expired

  @@map("referral_status")
}

model Referral {
  id             String         @id @default(uuid())
  referrerUserId String         @map("referrer_user_id")
  referredUserId String         @unique @map("referred_user_id")
  code           String         @map("code")
  status         ReferralStatus @default(pending)
  bonusGranted   Boolean        @default(false) @map("bonus_granted")
  qualifiedAt    DateTime?      @map("qualified_at")
  createdAt      DateTime       @default(now()) @map("created_at")

  referrer User @relation("ReferralsMade", fields: [referrerUserId], references: [id], onDelete: Cascade)
  referred User @relation("ReferredBy", fields: [referredUserId], references: [id], onDelete: Cascade)

  @@index([referrerUserId])
  @@index([status, createdAt])
  @@map("referrals")
}

enum SubscriptionTier {
  free
  pro
  business
}

enum SubscriptionStatus {
  active
  canceled
  past_due
  incomplete
  trialing
  paused
}

enum ShieldStatus {
  active
  acted
  expired
}

enum RateWatchDirection {
  above
  below
}

enum AppPlatform {
  ios
  android

  @@map("app_platform")
}

enum PurchaseRequestStatus {
  PENDING
  APPROVED
  REJECTED
  PURCHASED
  EXPIRED
}

enum ApprovalRule {
  MAJORITY
  UNANIMOUS
  OWNER_ONLY
}

enum VoteChoice {
  APPROVE
  REJECT
  ABSTAIN
}

enum FeedEventType {
  EXPENSE_ADDED
  INCOME_ADDED
  PURCHASE_REQUEST_CREATED
  PURCHASE_REQUEST_APPROVED
  PURCHASE_REQUEST_PURCHASED
  PURCHASE_REQUEST_REJECTED
}

// ---- Models ----

model User {
  id                         String        @id @default(uuid())
  email                      String        @unique
  passwordHash               String?       @map("password_hash")
  googleId                   String?       @unique @map("google_id")
  name                       String
  currencyCode               String        @default("USD") @map("currency_code")
  timezone                   String        @default("UTC")
  language                   String        @default("en")
  inflationCountry           String?       @map("inflation_country")
  pushToken                  String?       @map("push_token")
  notifyBudgetAlerts         Boolean       @default(true) @map("notify_budget_alerts")
  notifySharedActivity       Boolean       @default(true) @map("notify_shared_activity")
  notifyDebtReminders        Boolean       @default(true) @map("notify_debt_reminders")
  notifyRecurringExpenses    Boolean       @default(true) @map("notify_recurring_expenses")
  notifySubscriptionRenewals Boolean       @default(true) @map("notify_subscription_renewals")
  notifyAnomalyAlerts        Boolean       @default(true) @map("notify_anomaly_alerts")
  notifyTrackingGap          Boolean       @default(true) @map("notify_tracking_gap")
  notifyPurchaseRequests     Boolean       @default(true) @map("notify_purchase_requests")
  notifyTripSettleUp         Boolean       @default(true) @map("notify_trip_settle_up")
  notifyShoppingReminders    Boolean       @default(true) @map("notify_shopping_reminders")
  notifyShoppingDeals        Boolean       @default(true) @map("notify_shopping_deals")
  notifyInflationShield      Boolean       @default(true) @map("notify_inflation_shield")
  notifyMonthlyWrapped       Boolean       @default(true) @map("notify_monthly_wrapped")
  voiceDigestEnabled         Boolean       @default(false) @map("voice_digest_enabled")
  voiceDigestDay             Int           @default(1) @map("voice_digest_day")
  voiceDigestHour            Int           @default(8) @map("voice_digest_hour")
  voiceDigestChannel         String?       @map("voice_digest_channel")
  voiceDigestLastSentAt      DateTime?     @map("voice_digest_last_sent_at")
  // ABA-335 (Community Price Map, M1): personal, opt-in consent to contribute
  // anonymized receipt price observations to the crowdsourced corpus. Default
  // false (GDPR opt-in). Consent is personal (not an Account setting) — only
  // the human who created a given expense can consent to sharing it.
  contributeCommunityPrices  Boolean       @default(false) @map("contribute_community_prices")
  themeMode                  String        @default("system") @map("theme_mode")
  accentColor                String?       @map("accent_color")
  // LEGACY single-pair payment info (receipt-split guest page). `UserPaymentMethod`
  // below is now the authoritative, multi-method source — this pair is kept only as a
  // read-fallback for existing users' data (never dropped/backfilled) and is still
  // mirrored on write so older clients/rows stay consistent. Do not add new callers.
  paymentMethod              SettleMethod? @map("payment_method")
  paymentHandle              String?       @map("payment_handle")
  isActive                   Boolean       @default(true) @map("is_active")
  isVerified                 Boolean       @default(false) @map("is_verified")
  emailVerificationCode      String?       @map("email_verification_code")
  emailVerificationExpiresAt DateTime?     @map("email_verification_expires_at")
  defaultAccountId           String?       @map("default_account_id")
  lastSyncAt                 DateTime?     @map("last_sync_at")
  passwordResetCode          String?       @map("password_reset_code")
  passwordResetExpiresAt     DateTime?     @map("password_reset_expires_at")
  emailChangePending         String?       @map("email_change_pending")
  emailChangeCode            String?       @map("email_change_code")
  emailChangeExpiresAt       DateTime?     @map("email_change_expires_at")
  createdAt                  DateTime      @default(now()) @map("created_at")
  updatedAt                  DateTime      @updatedAt @map("updated_at")
  referralCode               String?       @unique @map("referral_code")
  referralsMade              Referral[]    @relation("ReferralsMade")
  referredBy                 Referral?     @relation("ReferredBy")

  // Relations
  expenses               Expense[]
  incomes                Income[]
  budgets                Budget[]
  categories             Category[]
  chatConversations      ChatConversation[]
  budgetAlerts           BudgetAlert[]
  syncLogs               SyncLog[]
  ownedAccounts          Account[]               @relation("OwnedAccounts")
  accountMembers         AccountMember[]
  walletBalances         WalletBalance[]
  currencyExchanges      CurrencyExchange[]
  accountTransfers       AccountTransfer[]
  subscription           Subscription?
  usageLogs              UsageLog[]
  achievements           UserAchievement[]
  streaks                UserStreak[]
  portfolioHoldings      PortfolioHolding[]
  investmentTransactions InvestmentTransaction[]
  encryptionProfile      UserEncryptionProfile?
  accountEncryptionKeys  AccountEncryptionKey[]

  // AI preferences
  aiResponseMode String @default("balanced") @map("ai_response_mode")
  aiModel        String @default("balanced") @map("ai_model")

  // Report preferences
  weeklyEmailEnabled   Boolean @default(false) @map("weekly_email_enabled")
  weeklyEmailDay       Int     @default(1) @map("weekly_email_day")
  monthlyDigestEnabled Boolean @default(false) @map("monthly_digest_enabled")

  // Report & backup relations
  generatedReports GeneratedReport[]
  backupHistory    BackupHistory[]
  savingsGoals     SavingsGoal[]

  // Admin panel relations
  adminAuditLogs              AdminAuditLog[]
  adminNotificationLogs       NotificationLog[]
  adminScheduledNotifications ScheduledNotification[]

  // Telegram
  telegramLink      TelegramLink?
  telegramLinkCodes TelegramLinkCode[]

  // WhatsApp
  whatsappLink      WhatsAppLink?
  whatsappLinkCodes WhatsAppLinkCode[]

  // Slack
  slackLink      SlackLink?
  slackLinkCodes SlackLinkCode[]

  importBatches        ImportBatch[]
  purchaseRequests     PurchaseRequest[]     @relation("PurchaseRequestCreator")
  purchaseRequestVotes PurchaseRequestVote[] @relation("PurchaseRequestVoter")
  feedEvents           FamilyFeedEvent[]
  feedReactions        FeedReaction[]
  tripExpenseShares    TripExpenseShare[]
  paymentMethods       UserPaymentMethod[]
  restoreCredentials   RestoreCredential[]
  exchangeRateWatches  ExchangeRateWatch[]
  telemetryEvents      TelemetryEvent[]
  chatConversationPins ChatConversationPin[]
  salaryProfiles       SalaryProfile[]

  // Shared groups (ABA-640)
  notifyGroupActivity     Boolean              @default(true) @map("notify_group_activity")
  // Weekly "you owe / you are owed" reminders about an open group balance (ABA-653). A separate
  // question from notifyGroupActivity ("tell me what changed" vs "nag me about money").
  notifyGroupReminders    Boolean              @default(true) @map("notify_group_reminders")
  ownedExpenseGroups      ExpenseGroup[]       @relation("OwnedExpenseGroups")
  expenseGroupMemberships ExpenseGroupMember[]

  // Inbound e-receipts by e-mail forwarding (ABA-644)
  inboundMailAddress InboundMailAddress?
  inboundReceipts    InboundReceipt[]

  // Where this signup came from, captured from the CTA query string on the visitor's
  // FIRST arrival at the web app and replayed at registration (ABA-436). Flat columns
  // rather than one Json blob on purpose: the admin groups by these, and Prisma cannot
  // groupBy on Json. Nullable everywhere — every user who registered before this, every
  // native install, and anyone arriving without params has all four NULL, which is a
  // legitimate "unknown", not a defect to backfill.
  acquisitionSource      String? @map("acquisition_source")
  acquisitionLocation    String? @map("acquisition_location")
  acquisitionLanguage    String? @map("acquisition_language")
  acquisitionPlan        String? @map("acquisition_plan")
  acquisitionReferrerRaw String? @map("acquisition_referrer_raw")

  @@index([acquisitionSource])
  @@index([voiceDigestEnabled])
  @@map("users")
}

// Lets a payer offer several payment methods (e.g. BLIK + Revolut + PayPal) on the
// receipt-split guest page instead of exactly one. This table is the authoritative
// source for a user's payment info; User.paymentMethod/paymentHandle above are a
// legacy single-pair read-fallback for users who haven't set this up yet.
model UserPaymentMethod {
  id        String       @id @default(uuid())
  userId    String       @map("user_id")
  method    SettleMethod
  handle    String
  sortOrder Int          @default(0) @map("sort_order")
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, method])
  @@index([userId])
  @@map("user_payment_methods")
}

/// An Android Restore Credential (a WebAuthn public-key credential managed by
/// the system restore service). Several rows per user on purpose: a unique on
/// userId would let a second device's registration overwrite the first, and a
/// restore from the older backup would then fail against a public key we no
/// longer hold. Nothing here is secret — a public key and a credential id are
/// safe at rest — so no encryption tier applies.
model RestoreCredential {
  id           String    @id @default(uuid())
  userId       String    @map("user_id")
  credentialId String    @unique @map("credential_id")
  publicKey    Bytes     @map("public_key")
  counter      Int       @default(0)
  transports   String[]  @default([])
  createdAt    DateTime  @default(now()) @map("created_at")
  lastUsedAt   DateTime? @map("last_used_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_restore_credentials")
}

// Personal "notify me when this pair hits my target" rate alerts (no accountId — not
// shared-account data). One-shot: fires once, then isActive is flipped false rather than
// deleted, so the small mobile list can still show recent history.
model ExchangeRateWatch {
  id            String             @id @default(uuid())
  userId        String             @map("user_id")
  fromCurrency  String             @map("from_currency")
  toCurrency    String             @map("to_currency")
  targetRate    Decimal            @map("target_rate") @db.Decimal(12, 6)
  direction     RateWatchDirection
  isActive      Boolean            @default(true) @map("is_active")
  createdAt     DateTime           @default(now()) @map("created_at")
  triggeredAt   DateTime?          @map("triggered_at")
  triggeredRate Decimal?           @map("triggered_rate") @db.Decimal(12, 6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isActive, fromCurrency])
  @@map("exchange_rate_watches")
}

model Account {
  id                   String       @id @default(uuid())
  name                 String
  type                 AccountType
  currencyCode         String       @default("USD") @map("currency_code")
  ownerId              String       @map("owner_id")
  icon                 String?
  isActive             Boolean      @default(true) @map("is_active")
  encryptionEnabled    Boolean      @default(false) @map("encryption_enabled")
  encryptionTier       Int          @default(0) @map("encryption_tier")
  keyRotationNeeded    Boolean      @default(false) @map("key_rotation_needed")
  createdAt            DateTime     @default(now()) @map("created_at")
  updatedAt            DateTime     @updatedAt @map("updated_at")
  purchaseApprovalRule ApprovalRule @default(MAJORITY) @map("purchase_approval_rule")
  monthAnchorDay       Int?         @map("month_anchor_day")
  aiImportConsentAt    DateTime?    @map("ai_import_consent_at")
  tripStartDate        DateTime?    @map("trip_start_date") @db.Date
  tripEndDate          DateTime?    @map("trip_end_date") @db.Date
  tripStatus           TripStatus?  @map("trip_status")

  // Relations
  owner                          User                            @relation("OwnedAccounts", fields: [ownerId], references: [id], onDelete: Cascade)
  members                        AccountMember[]
  invitations                    AccountInvitation[]
  expenses                       Expense[]
  incomes                        Income[]
  budgets                        Budget[]
  categories                     Category[]
  syncLogs                       SyncLog[]
  walletBalances                 WalletBalance[]
  currencyExchanges              CurrencyExchange[]
  transfersOut                   AccountTransfer[]               @relation("TransfersOut")
  transfersIn                    AccountTransfer[]               @relation("TransfersIn")
  usageLogs                      UsageLog[]
  generatedInsights              GeneratedInsight[]
  spendingStories                SpendingStory[]
  tags                           Tag[]
  projects                       Project[]
  achievements                   UserAchievement[]
  streaks                        UserStreak[]
  portfolioHoldings              PortfolioHolding[]
  investmentTransactions         InvestmentTransaction[]
  encryptionKeys                 AccountEncryptionKey[]
  generatedReports               GeneratedReport[]
  backupHistory                  BackupHistory[]
  monthlyDigestCache             MonthlyDigestCache[]
  savingsGoals                   SavingsGoal[]
  fatFinderReports               FatFinderReport[]
  telegramLinks                  TelegramLink[]
  whatsappLinks                  WhatsAppLink[]
  slackLinks                     SlackLink[]
  csvImportMappings              CsvImportMapping[]
  chatConversations              ChatConversation[]
  importBatches                  ImportBatch[]
  userSubscriptions              UserSubscription[]
  anomalyAlerts                  AnomalyAlert[]
  merchantCategoryRules          MerchantCategoryRule[]
  productCategoryRules           ProductCategoryRule[]
  goalContributions              GoalContribution[]
  purchaseRequests               PurchaseRequest[]
  feedEvents                     FamilyFeedEvent[]
  settleUpTransactions           SettleUpTransaction[]
  productAliases                 ProductAlias[]
  shoppingLists                  ShoppingList[]
  shoppingListItems              ShoppingListItem[]
  shoppingListTemplates          ShoppingListTemplate[]
  inflationShieldRecommendations InflationShieldRecommendation[]
  shoppingNotificationLogs       ShoppingNotificationLog[]
  insightNotificationLogs        InsightNotificationLog[]
  salaryProfiles                 SalaryProfile[]
  inboundMailAddresses           InboundMailAddress[]
  inboundReceipts                InboundReceipt[]

  @@map("accounts")
}

model InflationShieldRecommendation {
  id              String       @id @default(uuid())
  accountId       String       @map("account_id")
  canonicalName   String       @map("canonical_name")
  periodMonth     String       @map("period_month") // "YYYY-MM"
  recommendedAt   DateTime     @default(now()) @map("recommended_at")
  priceAtRec      Decimal      @map("price_at_rec") @db.Decimal(12, 2) // base currency
  projectedPrice  Decimal      @map("projected_price") @db.Decimal(12, 2) // base currency
  qty             Int
  projectedSaving Decimal      @map("projected_saving") @db.Decimal(12, 2) // base currency
  currencyCode    String       @map("currency_code") // base at rec time
  status          ShieldStatus @default(active)
  actedAt         DateTime?    @map("acted_at")
  realizedSaving  Decimal?     @map("realized_saving") @db.Decimal(12, 2) // base currency
  account         Account      @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, canonicalName, periodMonth])
  @@index([accountId, status])
  @@map("inflation_shield_recommendations")
}

model AccountMember {
  id        String      @id @default(uuid())
  accountId String      @map("account_id")
  userId    String      @map("user_id")
  role      AccountRole
  joinedAt  DateTime    @default(now()) @map("joined_at")
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  paymentMethod SettleMethod? @map("payment_method")
  paymentHandle String?       @map("payment_handle")

  // Relations
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([accountId, userId])
  @@map("account_members")
}

model AccountInvitation {
  id            String           @id @default(uuid())
  accountId     String           @map("account_id")
  invitedBy     String           @map("invited_by")
  invitedEmail  String?          @map("invited_email")
  invitedUserId String?          @map("invited_user_id")
  inviteCode    String           @unique @map("invite_code")
  role          AccountRole      @default(editor)
  status        InvitationStatus @default(pending)
  expiresAt     DateTime         @map("expires_at")
  acceptedBy    String?          @map("accepted_by")
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")

  // Relations
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([inviteCode])
  @@index([invitedEmail])
  @@index([invitedUserId])
  @@map("account_invitations")
}

model Category {
  id                   String   @id @default(uuid())
  userId               String?  @map("user_id")
  accountId            String?  @map("account_id")
  name                 String
  icon                 String?
  color                String?
  coicopDivision       String?  @map("coicop_division")
  /// Who set coicopDivision: 'seed' (icon map) | 'model' (classifier) | 'user' (PATCH). ABA-617
  coicopSource         String?  @map("coicop_source")
  type                 String   @default("expense")
  isSystem             Boolean  @default(false) @map("is_system")
  parentId             String?  @map("parent_id")
  embedding            Json?    @map("embedding")
  isDeleted            Boolean  @default(false) @map("is_deleted")
  syncVersion          Int      @default(0) @map("sync_version")
  clientId             String?  @map("client_id")
  encryptedPayload     String?  @map("encrypted_payload")
  encryptionKeyVersion Int?     @map("encryption_key_version")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  // Relations
  user                  User?                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  account               Account?               @relation(fields: [accountId], references: [id], onDelete: Cascade)
  parent                Category?              @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children              Category[]             @relation("CategoryHierarchy")
  expenses              Expense[]
  incomes               Income[]
  expenseItems          ExpenseItem[]
  expenseCategorySplits ExpenseCategorySplit[]
  budgetCategories      BudgetCategory[]
  budgetAlerts          BudgetAlert[]
  userSubscriptions     UserSubscription[]
  merchantCategoryRules MerchantCategoryRule[]
  productCategoryRules  ProductCategoryRule[]

  @@unique([accountId, name, type])
  @@unique([accountId, clientId])
  @@map("categories")
}

model Expense {
  id                  String    @id @default(uuid())
  userId              String    @map("user_id")
  accountId           String    @map("account_id")
  clientId            String    @map("client_id")
  categoryId          String?   @map("category_id")
  amount              Decimal   @db.Decimal(12, 2)
  discountAmount      Decimal?  @map("discount_amount") @db.Decimal(12, 2)
  depositAmount       Decimal?  @map("deposit_amount") @db.Decimal(12, 2)
  currencyCode        String    @default("USD") @map("currency_code")
  description         String?
  notes               String?
  merchant            String?
  date                DateTime  @db.Date
  time                String?
  locationLat         Decimal?  @map("location_lat") @db.Decimal(10, 8)
  locationLng         Decimal?  @map("location_lng") @db.Decimal(11, 8)
  locationName        String?   @map("location_name")
  receiptUrl          String?   @map("receipt_url")
  isRecurring         Boolean   @default(false) @map("is_recurring")
  recurringId         String?   @map("recurring_id")
  recurringPeriod     String?   @map("recurring_period")
  source              String    @default("manual")
  externalRef         String?   @map("external_ref")
  importBatchId       String?   @map("import_batch_id")
  isDebt              Boolean   @default(false) @map("is_debt")
  isDebtRepayment     Boolean   @default(false) @map("is_debt_repayment")
  debtContactName     String?   @map("debt_contact_name")
  debtDueDate         DateTime? @map("debt_due_date") @db.Date
  relatedDebtIncomeId String?   @map("related_debt_income_id")
  isDeleted           Boolean   @default(false) @map("is_deleted")
  isPlanned           Boolean   @default(false) @map("is_planned")
  isSplitReceivable   Boolean   @default(false) @map("is_split_receivable")
  syncVersion         Int       @default(0) @map("sync_version")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  encryptedPayload     String? @map("encrypted_payload")
  encryptionKeyVersion Int?    @map("encryption_key_version")

  receiptImage       Bytes?  @map("receipt_image")
  receiptMimeType    String? @map("receipt_mime_type")
  /// SHA-256 of the receipt file as scanned (base64 text) — spots a re-upload of the same file before OCR (ABA-603).
  receiptFingerprint String? @map("receipt_fingerprint")

  paidByUserId String? @map("paid_by_user_id")

  // Relations
  user              User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  account           Account                   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  category          Category?                 @relation(fields: [categoryId], references: [id])
  importBatch       ImportBatch?              @relation(fields: [importBatchId], references: [id])
  items             ExpenseItem[]
  expenseTags       ExpenseTag[]
  categorySplits    ExpenseCategorySplit[]
  projectExpenses   ProjectExpense[]
  purchaseRequest   PurchaseRequest?          @relation("PlannedPurchase")
  shares            TripExpenseShare[]
  splitParticipants ReceiptSplitParticipant[]

  @@unique([accountId, clientId])
  @@unique([accountId, externalRef])
  @@index([accountId, date(sort: Desc)])
  @@index([categoryId])
  @@index([accountId, isDebt])
  @@index([accountId, merchant])
  @@index([accountId, receiptFingerprint])
  @@index([accountId, source])
  @@index([accountId, isPlanned])
  @@map("expenses")
}

model ExpenseItem {
  id                   String   @id @default(uuid())
  expenseId            String   @map("expense_id")
  description          String
  canonicalName        String?  @map("canonical_name")
  categoryId           String?  @map("category_id")
  quantity             Decimal  @default(1) @db.Decimal(10, 3)
  unitPrice            Decimal  @default(0) @map("unit_price") @db.Decimal(12, 2)
  totalPrice           Decimal  @map("total_price") @db.Decimal(12, 2)
  lineDiscount         Decimal  @default(0) @map("line_discount") @db.Decimal(12, 2)
  sortOrder            Int      @default(0) @map("sort_order")
  isDeleted            Boolean  @default(false) @map("is_deleted")
  syncVersion          Int      @default(0) @map("sync_version")
  encryptedPayload     String?  @map("encrypted_payload")
  encryptionKeyVersion Int?     @map("encryption_key_version")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  // Relations
  expense  Expense   @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([expenseId])
  @@index([categoryId])
  @@map("expense_items")
}

// Receipt split (ABA — see task-1 brief): the payer splits a receipt by line
// item (or equally) and sends each participant a public, tokenized link
// showing only their own share, with no account required. This table stores
// only the link and its state — the actual receivable is a normal isDebt
// Expense (debtContactName = participant's name), created by a later task.
//
// The FK's ON DELETE CASCADE only fires on a genuine hard delete. The app
// soft-deletes expenses (isDeleted), which does NOT trigger it, so
// ExpensesService.remove clears a split's debt rows and expires its
// participants explicitly. Do not assume the cascade covers that path —
// without the explicit cleanup, guest links stay live for a deleted receipt.
model ReceiptSplitParticipant {
  id            String    @id @default(uuid())
  accountId     String    @map("account_id")
  expenseId     String    @map("expense_id")
  // Participant index within the create loop (0-based). Together with expenseId
  // this backs a hand-written partial unique index (see the migration —
  // `receipt_split_live_slot` on (expense_id, seq) WHERE cancelled_at IS NULL)
  // that enforces "at most one live split per expense": a concurrent double-create
  // collides here, and a re-split after cancel is free to reuse seq 0 because the
  // old cancelled rows have dropped out of the index. Prisma cannot express a
  // partial index, so there is deliberately no @@unique for it in this schema.
  seq           Int
  name          String
  token         String    @unique
  // Set ONLY on the seq:0 ("anchor") row of a split, at creation time — one
  // shared group-picker token per split, not per participant. NULL for every
  // split created before this column existed (no backfill) and for every
  // non-anchor row of a split created after it. See
  // docs/contracts/qr-code-bill-split-api.md for the full design (QR-code
  // bill split — scan one code, pick your own name).
  groupToken    String?   @unique @map("group_token")
  amount        Decimal   @db.Decimal(12, 2)
  currencyCode  String    @map("currency_code")
  itemIds       Json?     @map("item_ids")
  // Explicit per-line share, in basis points (6000 = 60%), keyed by item id —
  // ABA-550. Sits BESIDE itemIds rather than reshaping it: itemIds is read as a
  // flat string array in eight places in guest.controller.ts plus the flag
  // clamping and ABA-546's reassignment, and every split created before this
  // column exists carries one. NULL (and any line absent from the map) means
  // "divide this line equally among its claimants", the original behaviour.
  // A line's shares need not add up to 10000: the remainder is the PAYER's,
  // which is what lets "60% his, 40% mine" exist without a payer row.
  itemShareBp   Json?     @map("item_share_bp")
  debtExpenseId String?   @map("debt_expense_id")
  openedAt      DateTime? @map("opened_at")
  claimedAt     DateTime? @map("claimed_at")
  settledAt     DateTime? @map("settled_at")
  // Distinct from a naturally-expired split (expiresAt in the past, cancelledAt still
  // null): a split the payer explicitly cancels must become fully inert (re-splittable,
  // not reported as live, cannot be confirmed) while a split that merely aged past its
  // 30-day expiresAt with debts still unsettled must remain visible to the createSplit
  // idempotency check — otherwise re-splitting would mint a second set of debt rows for
  // the same people. Do NOT collapse this into expiresAt.
  cancelledAt   DateTime? @map("cancelled_at")
  expiresAt     DateTime  @map("expires_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  expense Expense            @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  flags   ReceiptSplitFlag[]

  @@index([expenseId])
  @@map("receipt_split_participants")
}

// A guest's report that one line (or their whole share) is wrong — "I wasn't
// part of this" / "this was split among the wrong number of people" (ABA —
// guest-split-item-dispute). Public, unauthenticated write, same posture as
// the rest of GuestController: never trusts a raw itemId, see
// docs/contracts/guest-split-item-dispute.md.
//
// No FK from itemId to ExpenseItem.id — deliberately loose, same reasoning as
// ReceiptSplitParticipant.itemIds (a raw Json array of ids, not a relation):
// the flagged item may later be edited away by the payer recreating the
// split, and a flag on a cancelled split's participant simply stops appearing
// anywhere once that participant drops out of every `cancelledAt: null`
// query — no explicit cleanup needed.
//
// No DB-level unique on (participantId, itemId): Postgres treats every NULL
// as distinct, so a unique index couldn't enforce "one whole-share flag ever"
// regardless. "At most one OPEN flag per participant+item" is an app-level
// anti-spam property (find-then-create-or-update in the service), not a hard
// invariant worth a partial index for.
model ReceiptSplitFlag {
  id            String    @id @default(uuid())
  accountId     String    @map("account_id")
  participantId String    @map("participant_id")
  expenseId     String    @map("expense_id")
  // The expense_item id this flag is about, or null for a whole-share report
  // (equal-split mode, or "I wasn't in this split at all").
  itemId        String?   @map("item_id")
  // Guest's optional free-text note, trimmed + capped at 500 chars server-side.
  // Rendered as plain text only (the payer's mobile client), never as HTML.
  note          String?
  createdAt     DateTime  @default(now()) @map("created_at")
  // Set once the payer taps "Resolve". null = still open — this is what both
  // the payer's status list and the guest page's "reported" state key off.
  resolvedAt    DateTime? @map("resolved_at")

  participant ReceiptSplitParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@index([participantId])
  @@index([expenseId])
  @@map("receipt_split_flags")
}

model ProductAlias {
  id            String   @id @default(uuid())
  accountId     String   @map("account_id")
  rawName       String   @map("raw_name")
  canonicalName String   @map("canonical_name")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, rawName])
  @@index([accountId])
  @@map("product_aliases")
}

// Anonymized, k-anonymity-gated crowdsourced price observations (ABA-335, M1 —
// write pipeline only; no read surface yet). One row per (contributing account,
// product, store, region, ISO-week, currency) — the upsert on the unique key
// below overwrites `price` on repeat purchases within the same week, so a
// single user can't inflate the observation count or skew a future average.
//
// Deliberately holds NO accountId, NO userId, NO expenseId, and NO user
// coordinates. `contributorKey` is a salted one-way hash of the contributing
// accountId — used ONLY for the one-vote-per-account-per-week dedup (this
// unique constraint) and, later, the read-path k-anonymity gate
// (COUNT(DISTINCT contributor_key) >= K); it is never exposed to clients.
// `region` is derived from the STORE's (point-of-sale) location via reverse
// geocoding — never the contributor's own location.
model CommunityPriceObservation {
  id                 String   @id @default(uuid())
  canonicalName      String   @map("canonical_name")
  merchantNormalized String   @map("merchant_normalized")
  region             String
  weekStart          DateTime @map("week_start") @db.Date
  currencyCode       String   @map("currency_code")
  price              Decimal  @db.Decimal(12, 2)
  contributorKey     String   @map("contributor_key")
  // ABA-642 anti-Sybil. `attested` marks a row written from a server-signed scan
  // token (per-user contributorKey, server-geocoded store). Rows that predate it
  // keep the default `false` and are NEVER aggregated or searched — they were
  // contributed without attestation and keyed per account. They are kept, not
  // deleted. `trusted` is a coarse contribution-time boolean (account tenure or
  // Stripe-paid), not identity.
  attested           Boolean  @default(false)
  trusted            Boolean  @default(false)
  // ABA-642 audit. Monday of the week the row was CONTRIBUTED (not the receipt's
  // week): the multi-week persistence gate counts these, so back-dated receipts
  // written in one sitting cannot pose as two weeks of history. Set once, on create.
  ingestWeek         DateTime @default(now()) @map("ingest_week") @db.Date
  createdAt          DateTime @default(now()) @map("created_at")

  @@unique([canonicalName, merchantNormalized, region, weekStart, currencyCode, contributorKey], name: "community_obs_dedup", map: "community_obs_dedup_key")
  @@index([canonicalName, region, weekStart], map: "community_obs_product_region_week_idx")
  @@index([weekStart], map: "community_obs_week_start_idx")
  @@index([contributorKey, weekStart], map: "community_obs_contributor_week_idx")
  @@map("community_price_observations")
}

// Store-location lookup for the community price MAP (ABA-335 M4). Holds ONLY the
// STORE's public point-of-sale coordinate keyed by (merchantNormalized, region) —
// NO accountId / userId / contributorKey / per-observation link. A store is a
// public place, so this is not contributor PII; the map read only ever exposes a
// pin for a store that has already cleared the k-anonymity gate. Populated
// fire-and-forget from the same write path that records observations.
model CommunityStoreGeo {
  id                 String   @id @default(uuid())
  merchantNormalized String   @map("merchant_normalized")
  region             String
  lat                Decimal  @db.Decimal(10, 7)
  lng                Decimal  @db.Decimal(10, 7)
  // ABA-642. `false` = a pin written before attestation, possibly from client GPS
  // (a contributor's home). Kept, never overwritten, never shown. `true` = the
  // server-geocoded printed address from a signed scan, create-only. `attested`
  // is part of the unique key so a legacy row cannot block a real pin.
  attested           Boolean  @default(false)
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@unique([merchantNormalized, region, attested], name: "community_store_geo_key", map: "community_store_geo_key")
  @@map("community_store_geo")
}

// ABA-642 audit — store-pin candidates. A pin is NOT published on first write (that
// let one contributor squat a store's pin): each attested receipt adds one candidate
// coordinate, one per (merchant, region, contributor), and `CommunityStoreGeo` is only
// written once >= k DISTINCT contributors' candidates agree within a radius, at their
// median. `contributorKey` is the same one-way hash the observation rows already hold,
// so this adds no new link; it is never exposed. Pruned with the receipt-seen rows.
model CommunityStorePinCandidate {
  id                 String   @id @default(uuid())
  merchantNormalized String   @map("merchant_normalized")
  region             String
  contributorKey     String   @map("contributor_key")
  lat                Decimal  @db.Decimal(10, 7)
  lng                Decimal  @db.Decimal(10, 7)
  createdAt          DateTime @default(now()) @map("created_at")

  @@unique([merchantNormalized, region, contributorKey], name: "community_pin_candidate_key", map: "community_pin_candidate_key")
  @@index([createdAt], map: "community_pin_candidate_created_idx")
  @@map("community_store_pin_candidates")
}

// ABA-642 D4 — one physical receipt contributes once, from anyone. `contentKey` is
// an HMAC of the receipt's own content (merchant, date, time, total, line hashes);
// NO account, user or contributor link. Pruned weekly (rows older than 12 weeks).
model CommunityReceiptSeen {
  contentKey String   @id @map("content_key")
  weekStart  DateTime @map("week_start") @db.Date
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([weekStart], map: "community_receipt_seen_week_idx")
  @@map("community_receipt_seen")
}

model ShoppingList {
