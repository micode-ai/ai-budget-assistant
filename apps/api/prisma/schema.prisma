enum ExpenseGroupStatus {
  active
  archived
}

model ExpenseGroup {
  id            String             @id @default(uuid())
  name          String // 1..60, trimmed
  emoji         String? // single grapheme, optional
  currencyCode  String             @map("currency_code") // immutable once any expense exists
  // NULL = orphaned (ABA-650): the owner left the platform and no live member with an active
  // account could succeed them. Members and guests keep using it; only owner actions wait until an
  // app-user member adopts it.
  ownerUserId   String?            @map("owner_user_id")
  // When the owner became NULL. Adoption is open only to members who were live BEFORE this moment
  // (a joiner after it must not take the group over). Stamped by GroupOwnershipService and, for the
  // SetNull FK backstop, by the expense_groups_orphaned_at trigger in the migration.
  orphanedAt    DateTime?          @map("orphaned_at")
  // Bearer credential for the public link: randomBytes(16).hex (128-bit, same TOKEN_BYTES as
  // receipt-split). Stored plain because the members re-share it. Rotation = new value.
  guestToken    String             @unique @map("guest_token")
  guestAccess   Boolean            @default(true) @map("guest_access") // owner kill-switch
  status        ExpenseGroupStatus @default(active)
  // Compare-and-swap counter, bumped by EVERY ledger write inside its $transaction.
  // A settlement must quote the version it was computed against (see "Settle-up").
  ledgerVersion Int                @default(0) @map("ledger_version")
  archivedAt    DateTime?          @map("archived_at")
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")

  // SetNull, never Cascade (ABA-650): GroupOwnershipService hands the group on before an account
  // goes away; a path that forgets that hook orphans the group instead of deleting it for everyone.
  owner       User?                @relation("OwnedExpenseGroups", fields: [ownerUserId], references: [id], onDelete: SetNull)
  members     ExpenseGroupMember[]
  expenses    GroupExpense[]
  settlements GroupSettlement[]
  events      GroupMemberEvent[]

  @@index([ownerUserId])
  @@map("expense_groups")
}

// How a member row came to be, for the admin group metrics (ABA-647). NULL on rows created before
// this column existed: there is deliberately NO backfill, so old groups are simply not attributed.
enum ExpenseGroupJoinVia {
  owner // the group creator
  placeholder // a name added in advance by a member and not claimed through a tracked path
  app_link // an app user who joined through the link (new row, or claiming a placeholder)
  guest // a browser guest (new row, or claiming a placeholder on the guest page)
  guest_linked // a guest that later bound its row to an app account
}

model ExpenseGroupMember {
  id                 String               @id @default(uuid())
  groupId            String               @map("group_id")
  userId             String?              @map("user_id") // NULL = guest
  displayName        String               @map("display_name") // 1..40, trimmed, shown to everyone with the link
  nameKey            String               @map("name_key") // displayName.trim().toLowerCase()
  // sha256(hex) of the guest's device secret (the cookie value). NULL = unclaimed placeholder
  // (added by name, nobody has taken it yet). An app-user member has no secret until it
  // also uses a browser. Never stored in plaintext.
  claimTokenHash     String?              @unique @map("claim_token_hash")
  claimedAt          DateTime?            @map("claimed_at")
  paymentMethod      SettleMethod?        @map("payment_method") // set per group by the member themself
  paymentHandle      String?              @map("payment_handle") // ≤ 64 chars
  removedAt          DateTime?            @map("removed_at") // soft removal, only at zero balance
  // True when the OWNER removed this member (not a self-leave). Such a member cannot rejoin via
  // the link (403 GROUP_REMOVED); a self-removed one can, through the normal join checks.
  removedByOwner     Boolean              @default(false) @map("removed_by_owner")
  // Provenance for metrics only (ABA-647). NULL = created before the column; never backfilled.
  joinedVia          ExpenseGroupJoinVia? @map("joined_via")
  linkedAt           DateTime?            @map("linked_at") // when a guest row was bound to an app account
  // Balance reminder episode (ABA-653), maintained only by GroupReminderCron, app-user rows only.
  // An episode is an open balance (|net| >= 1.00) of one sign; it ends when the balance closes or the
  // sign flips, and the cron then resets all four columns. NULL with an open balance = the clock
  // starts on the next run (no backfill).
  balanceOpenSince   DateTime?            @map("balance_open_since")
  balanceOpenSign    Int?                 @map("balance_open_sign") // -1 owes, 1 is owed
  lastReminderAt     DateTime?            @map("last_reminder_at")
  reminderCount      Int                  @default(0) @map("reminder_count") // at most 4 per episode
  // ABA-657: set on an ABSORBED row when it was merged into another member of the same group. The
  // row stays, soft-removed, so history still reads; every ledger row it held now points at that
  // member. A plain id with no FK, like the event log (a merge is irreversible).
  mergedIntoMemberId String?              @map("merged_into_member_id")
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")

  user            User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  group           ExpenseGroup        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  paidExpenses    GroupExpense[]      @relation("GroupExpensePayer")
  shares          GroupExpenseShare[]
  settlementsFrom GroupSettlement[]   @relation("GroupSettlementFrom")
  settlementsTo   GroupSettlement[]   @relation("GroupSettlementTo")
  itemClaims      GroupItemClaim[]

  @@unique([groupId, nameKey]) // names are the guest's only identity cue; no duplicates
  @@unique([groupId, userId]) // one member per app user per group (NULLs distinct → many guests)
  @@index([userId])
  @@map("expense_group_members")
}

model GroupExpense {
  id                String    @id @default(uuid())
  groupId           String    @map("group_id")
  description       String // 1..120
  amount            Decimal   @db.Decimal(12, 2) // group currency, > 0, ≤ 1_000_000
  date              DateTime  @db.Date
  paidByMemberId    String    @map("paid_by_member_id")
  splitType         ShareType @map("split_type") // reuses the trip enum
  createdByMemberId String    @map("created_by_member_id")
  // ABA-654: write-time FX. All NULL = entered in the group currency (no backfill). Otherwise
  // `amount` is round2(originalAmount * fxRate), converted ONCE when written and never on read.
  originalAmount    Decimal?  @map("original_amount") @db.Decimal(12, 2)
  originalCurrency  String?   @map("original_currency")
  fxRate            Decimal?  @map("fx_rate") @db.Decimal(18, 8) // 1 original = fxRate group currency
  fxRateSource      String?   @map("fx_rate_source") // provider | manual
  fxRateAt          DateTime? @map("fx_rate_at")
  // ABA-655: line items + claims. An itemised expense stores splitType = exact with the shares
  // RESOLVED from its claims (receipt-split math), so balances never learn about items. Lines and
  // `discountAmount` are in the ENTRY currency (originalCurrency when set). Claims are open to every
  // live member until `claimsOpenUntil` (creation + 7 days, or "now" once closed); after that only
  // the payer, creator or owner changes them. NULL / false on every non-itemised row.
  itemized          Boolean   @default(false)
  discountAmount    Decimal?  @map("discount_amount") @db.Decimal(12, 2) // basket-wide discount
  claimsOpenUntil   DateTime? @map("claims_open_until")
  // Idempotency: app = client UUID; guest = hidden `rid` nonce minted at form render.
  clientRequestId   String?   @map("client_request_id")
  deletedAt         DateTime? @map("deleted_at") // soft, shown in history, out of balances
  deletedByMemberId String?   @map("deleted_by_member_id")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  group  ExpenseGroup        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  paidBy ExpenseGroupMember  @relation("GroupExpensePayer", fields: [paidByMemberId], references: [id], onDelete: NoAction)
  shares GroupExpenseShare[]
  items  GroupExpenseItem[]

  @@unique([groupId, clientRequestId])
  @@index([groupId, deletedAt, date])
  @@map("group_expenses")
}

// ABA-655: one line of an itemised group expense (at most 100). Prices are in the expense's entry
// currency. Deleting a line cascades its claims, which is how stale claims are pruned in storage.
model GroupExpenseItem {
  id             String           @id @default(uuid())
  groupExpenseId String           @map("group_expense_id")
  name           String // 1..120
  totalPrice     Decimal          @map("total_price") @db.Decimal(12, 2) // gross line price
  lineDiscount   Decimal?         @map("line_discount") @db.Decimal(12, 2) // amount OFF this line
  position       Int
  createdAt      DateTime         @default(now()) @map("created_at")
  expense        GroupExpense     @relation(fields: [groupExpenseId], references: [id], onDelete: Cascade)
  claims         GroupItemClaim[]

  @@index([groupExpenseId])
  @@map("group_expense_items")
}

// ABA-655: a member's claim on a line. `shareBp` NULL = divide the line equally among its
// claimants; set = an explicit share in basis points (receipt-split's `itemShareBp`, per line),
// whatever is left of the line belongs to the payer. An explicit 0 is kept, never deleted.
model GroupItemClaim {
  id        String             @id @default(uuid())
  itemId    String             @map("item_id")
  memberId  String             @map("member_id")
  shareBp   Int?               @map("share_bp")
  createdAt DateTime           @default(now()) @map("created_at")
  item      GroupExpenseItem   @relation(fields: [itemId], references: [id], onDelete: Cascade)
  member    ExpenseGroupMember @relation(fields: [memberId], references: [id], onDelete: NoAction)

  @@unique([itemId, memberId])
  @@index([memberId])
  @@map("group_item_claims")
}

model GroupExpenseShare {
  id             String             @id @default(uuid())
  groupExpenseId String             @map("group_expense_id")
  memberId       String             @map("member_id")
  shareValue     Decimal?           @map("share_value") @db.Decimal(12, 4) // raw input (exact / % / units); NULL for equal
  shareAmount    Decimal            @map("share_amount") @db.Decimal(12, 2) // resolved by resolveShares
  expense        GroupExpense       @relation(fields: [groupExpenseId], references: [id], onDelete: Cascade)
  member         ExpenseGroupMember @relation(fields: [memberId], references: [id], onDelete: NoAction)

  @@unique([groupExpenseId, memberId])
  @@index([memberId])
  @@map("group_expense_shares")
}

model GroupSettlement {
  id                 String        @id @default(uuid())
  groupId            String        @map("group_id")
  fromMemberId       String        @map("from_member_id")
  toMemberId         String        @map("to_member_id")
  amount             Decimal       @db.Decimal(12, 2)
  method             SettleMethod?
  recordedByMemberId String        @map("recorded_by_member_id")
  clientRequestId    String?       @map("client_request_id")
  voidedAt           DateTime?     @map("voided_at")
  voidedByMemberId   String?       @map("voided_by_member_id")
  createdAt          DateTime      @default(now()) @map("created_at")

  group ExpenseGroup       @relation(fields: [groupId], references: [id], onDelete: Cascade)
  from  ExpenseGroupMember @relation("GroupSettlementFrom", fields: [fromMemberId], references: [id], onDelete: NoAction)
  to    ExpenseGroupMember @relation("GroupSettlementTo", fields: [toMemberId], references: [id], onDelete: NoAction)

  @@unique([groupId, clientRequestId])
  @@index([groupId, voidedAt])
  @@map("group_settlements")
}

// Membership events shown as system rows in the group activity (ABA-650). Shared with the later
// claim-reset and merge tasks. Member columns are plain ids with NO foreign key, so a merge never has
// to re-point audit rows; `subjectName` is a snapshot because the subject may leave or be merged.
enum GroupMemberEventKind {
  owner_transferred // manual transfer, succession on departure, orphaning (no target) or adoption
  member_merged
  claim_reset
}

model GroupMemberEvent {
  id              String               @id @default(uuid())
  groupId         String               @map("group_id")
  kind            GroupMemberEventKind
  actorMemberId   String?              @map("actor_member_id") // NULL = the system (account departure)
  subjectMemberId String               @map("subject_member_id")
  targetMemberId  String?              @map("target_member_id")
  subjectName     String               @map("subject_name")
  createdAt       DateTime             @default(now()) @map("created_at")

  group ExpenseGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId, createdAt])
  @@map("group_member_events")
}

// Inbound e-receipts by e-mail forwarding (ABA-644). One private address per user;
// forwarded mail becomes a pending InboundReceipt the user confirms in the app.
model InboundMailAddress {
  id              String    @id @default(uuid())
  userId          String    @unique @map("user_id")
  token           String    @unique // 16 chars [a-z2-7], 80 bits
  targetAccountId String    @map("target_account_id")
  disabledAt      DateTime? @map("disabled_at")
  rotatedAt       DateTime? @map("rotated_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  user          User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetAccount Account @relation(fields: [targetAccountId], references: [id], onDelete: Cascade)

  @@map("inbound_mail_addresses")
}

model InboundReceipt {
  id                     String   @id @default(uuid())
  userId                 String   @map("user_id")
  accountId              String   @map("account_id")
  kind                   String   @default("receipt") // receipt | forwarding_verification
  // received | processing | pending | confirmed | dismissed | duplicate
  // | not_a_receipt | quota_exceeded | unsupported | failed
  status                 String   @default("received")
  messageIdHash          String   @map("message_id_hash")
  contentHash            String?  @map("content_hash")
  fromAddress            String   @map("from_address")
  subject                String?
  authSpf                String?  @map("auth_spf")
  authDkim               String?  @map("auth_dkim")
  authDmarc              String?  @map("auth_dmarc")
  documentKind           String?  @map("document_kind") // pdf | image | text
  documentMime           String?  @map("document_mime")
  document               Bytes? // nulled on confirm/dismiss/expiry
  documentText           String?  @map("document_text") // text body, same lifecycle
  ignoredAttachmentCount Int      @default(0) @map("ignored_attachment_count")
  extraction             Json? // ReceiptExpense minus possibleDuplicate
  verificationCode       String?  @map("verification_code")
  expenseId              String?  @map("expense_id") // server PK after confirm
  attempts               Int      @default(0)
  errorCode              String?  @map("error_code")
  expiresAt              DateTime @map("expires_at")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([userId, messageIdHash])
  @@index([userId, accountId, status])
  @@index([status, updatedAt])
  @@index([expiresAt])
  @@map("inbound_receipts")
}
